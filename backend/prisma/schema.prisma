generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SubscriptionTier {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  monthlyFeeDZD      Float
  creditLimitDZD     Float
  minSalaryDZD       Float
  maxSalaryDZD       Float?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  subscriberProfiles SubscriberProfile[]
}

model Client {
  id                Int                @id @default(autoincrement())
  fullName          String
  email             String             @unique
  phoneNumber       String             @unique
  passwordHash      String
  role              Role               @default(CLIENT)
  accountStatus     AccountStatus      @default(REGISTERED)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  documents         Document[]
  mandate           Mandate?
  subscriberProfile SubscriberProfile?
  transactions      Transaction[]
  walletLogs        WalletLog[]
}

model SubscriberProfile {
  id              Int              @id @default(autoincrement())
  salaryAmount    Float
  salaryDay       Int
  salarySource    String
  creditLimitDZD  Float
  creditUsedDZD   Float            @default(0)
  creditResetDate DateTime
  verifiedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          Int              @unique
  tierId          Int
  tier            SubscriptionTier @relation(fields: [tierId], references: [id])
  user            Client           @relation(fields: [userId], references: [id])
}

model Document {
  id         Int            @id @default(autoincrement())
  type       DocumentType
  fileUrl    String
  status     DocumentStatus @default(PENDING)
  adminNotes String?
  uploadedAt DateTime       @default(now())
  reviewedAt DateTime?
  userId     Int
  user       Client         @relation(fields: [userId], references: [id])
}

model Mandate {
  id         Int           @id @default(autoincrement())
  rib        String
  status     MandateStatus @default(PENDING)
  signedAt   DateTime?
  ipAddress  String?
  deviceInfo String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  userId     Int           @unique
  user       Client        @relation(fields: [userId], references: [id])
}

model WalletLog {
  id          Int           @id @default(autoincrement())
  amount      Float
  type        WalletLogType
  referenceId Int?
  note        String?
  createdAt   DateTime      @default(now())
  userId      Int
  user        Client        @relation(fields: [userId], references: [id])
}

model Product {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  productPriceDZD Float
  productType     String
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  merchantId      Int
  merchant        Merchant      @relation(fields: [merchantId], references: [id])
  transactions    Transaction[]
}

model Transaction {
  id               Int               @id @default(autoincrement())
  creditAmount     Float
  merchantShare    Float
  status           TransactionStatus @default(PENDING)
  settlementStatus SettlementStatus  @default(PENDING)
  settledAt        DateTime?
  createdAt        DateTime          @default(now())
  userId           Int
  productId        Int
  product          Product           @relation(fields: [productId], references: [id])
  user             Client            @relation(fields: [userId], references: [id])
}

model Merchant {
  id           Int       @id @default(autoincrement())
  businessName String
  email        String    @unique
  phoneNumber  String    @unique
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

enum Role {
  ADMIN
  CLIENT
  MERCHANT
}

enum ProductType {
  ELECTRONICS
  FASHION
  GROCERY
  HOME
  BEAUTY
  SPORTS
  TOYS
  BOOKS
  OTHER
}

enum AccountStatus {
  REGISTERED
  PENDING_DOCS
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  EXPIRED
  DECLINED
}

enum DocumentType {
  NATIONAL_ID
  ADDRESS_PROOF
  EMPLOYMENT_CERT
  SALARY_SLIP
  SALARY_SCHEDULE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MandateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum WalletLogType {
  SUBSCRIPTION
  PURCHASE
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  COMPLETED
  FAILED
  PENDING
}

enum SettlementStatus {
  PENDING
  SETTLED
  FAILED
}
